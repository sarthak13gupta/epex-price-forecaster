# Copy to .env and fill in. Never commit the real .env.

# Environment toggle: "local" reads CSVs from disk, "production" reads from S3.
ENV=local

# ------------------------------------------------------------------------------
# Config
# ------------------------------------------------------------------------------
# Optional override for the config file location (default: configs/config.yaml)
# CONFIG_PATH=configs/config.yaml

# ------------------------------------------------------------------------------
# MLflow
# ------------------------------------------------------------------------------
# Overrides mlflow.tracking_uri in config.yaml. Point at a tracking server in
# deployment, e.g. http://mlflow:5000
#
# Must be a database URI, not file:. The MLflow file store is in maintenance
# mode in 3.x and has never supported the model registry, which this project
# depends on for the @champion alias.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# ------------------------------------------------------------------------------
# Service wiring
# ------------------------------------------------------------------------------
# Base URL the Streamlit frontend uses to reach the FastAPI backend.
API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# AWS / S3 (only required when ENV=production)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
S3_BUCKET_NAME=
S3_TRAIN_FILE_KEY=raw/epex/train/epex_fr_temp_train.csv
S3_PRED_FILE_KEY=raw/epex/predict/epex_fr_temp_pred.csv
