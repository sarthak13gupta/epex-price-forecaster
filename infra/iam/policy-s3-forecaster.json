{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRawAndArtifacts",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/raw/*",
        "arn:aws:s3:::__BUCKET__/processed/*",
        "arn:aws:s3:::__BUCKET__/mlflow-artifacts/*",
        "arn:aws:s3:::__BUCKET__/forecasts/*"
      ]
    },
    {
      "Sid": "WriteArtifactsForecastsAndProcessed",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/processed/*",
        "arn:aws:s3:::__BUCKET__/mlflow-artifacts/*",
        "arn:aws:s3:::__BUCKET__/forecasts/*"
      ]
    },
    {
      "Sid": "ListOneBucketOnly",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::__BUCKET__"
    }
  ]
}
